<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OBD Express</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%
  // Metric cards rendered below the cluster. Declared here so the markup stays
  // a single loop instead of nine near-identical blocks.
  const metrics = [
    { key: 'COOLANT_TEMP',   label: 'Koelvloeistof', unit: '&deg;C',    color: '#ff6b35' },
    { key: 'ENGINE_LOAD',    label: 'Motorbelasting', unit: '%',        color: '#7bed9f' },
    { key: 'THROTTLE',       label: 'Gaspedaal',      unit: '%',        color: '#ffd32a' },
    { key: 'FUEL_LEVEL',     label: 'Tankniveau',     unit: '%',        color: '#00d2d3' },
    { key: 'INTAKE_TEMP',    label: 'Inlaatlucht',    unit: '&deg;C',   color: '#54a0ff' },
    { key: 'MAF',            label: 'Luchtmassa',     unit: 'g/s',      color: '#a29bfe' },
    { key: 'TIMING_ADVANCE', label: 'Ontstekingstip', unit: '&deg;',    color: '#fd79a8' },
    { key: 'BATTERY',        label: 'Accuspanning',   unit: 'V',        color: '#badc58' },
  ];

  const stats = [
    { key: 'maxRpm',      label: 'Max toerental', unit: 'rpm' },
    { key: 'maxSpeed',    label: 'Max snelheid',  unit: 'km/h' },
    { key: 'avgSpeed',    label: 'Gem. snelheid', unit: 'km/h' },
    { key: 'durationSec', label: 'Rijduur',       unit: '' },
    { key: 'idleSec',     label: 'Stationair',    unit: '' },
    { key: 'fuelUsedL',   label: 'Verbruikt',     unit: 'L' },
    { key: 'avgL100',     label: 'Gem. verbruik', unit: 'L/100km' },
  ];
%>

  <div class="app">

    <!-- ── Header ──────────────────────────────────────────── -->
    <header class="header">
      <div class="header-brand">
        <span class="brand-icon">&#9650;</span>
        <h1 class="brand-title">OBD <span class="accent">Express</span></h1>
        <span id="status-badge" class="status-badge disconnected">&#9679; OFFLINE</span>
      </div>
      <div class="header-controls">
        <select id="port-select" class="select" aria-label="Seriële poort">
          <option value="">&#8212; Poort &#8212;</option>
        </select>
        <select id="baud-select" class="select" aria-label="Baud rate">
          <option value="auto" selected>Auto baud</option>
          <option value="38400">38400</option>
          <option value="9600">9600</option>
          <option value="115200">115200</option>
          <option value="500000">500000</option>
        </select>
        <button id="scan-btn"       class="btn btn-ghost">Scan</button>
        <button id="demo-btn"       class="btn btn-ghost" title="Bekijk het dashboard zonder auto">Demo</button>
        <button id="connect-btn"    class="btn btn-primary">Verbind</button>
        <button id="disconnect-btn" class="btn btn-danger" disabled>Verbreek</button>
      </div>
    </header>

    <main class="dashboard">

      <!-- ── Fault codes ────────────────────────────────────── -->
      <section class="panel dtc-panel" id="dtc-panel">
        <div class="panel-header">
          <div class="panel-title-group">
            <span class="panel-icon" id="dtc-icon">&#9675;</span>
            <h2 class="panel-title">Foutcodes</h2>
            <span class="badge" id="dtc-count" hidden></span>
          </div>
          <div class="panel-actions">
            <button id="read-dtc-btn"  class="btn btn-ghost btn-sm" disabled>Uitlezen</button>
            <button id="clear-dtc-btn" class="btn btn-warn  btn-sm" disabled>Wissen</button>
          </div>
        </div>
        <div class="panel-body" id="dtc-body">
          <span class="placeholder">Verbind met een adapter om foutcodes te lezen</span>
        </div>
      </section>

      <!-- ── Diagnostics row ────────────────────────────────── -->
      <div class="diag-row">
        <section class="panel" id="monitors-panel">
          <div class="panel-header">
            <div class="panel-title-group">
              <span class="panel-icon" id="mon-icon">&#9675;</span>
              <h2 class="panel-title">Readiness monitors</h2>
              <span class="badge" id="mon-badge" hidden></span>
            </div>
            <button id="read-monitors-btn" class="btn btn-ghost btn-sm" disabled>Controleer</button>
          </div>
          <div class="panel-body" id="monitors-body">
            <span class="placeholder">Verbind om monitors te controleren</span>
          </div>
        </section>

        <section class="panel" id="odometer-card">
          <div class="panel-header">
            <div class="panel-title-group">
              <h2 class="panel-title">Werkelijke km-stand</h2>
            </div>
            <button id="read-odometer-btn" class="btn btn-ghost btn-sm" disabled>Lees</button>
          </div>
          <div class="panel-body" id="odometer-body">
            <span class="placeholder">Verbind om uit te lezen</span>
          </div>
        </section>
      </div>

      <!-- ── Gauge cluster ──────────────────────────────────── -->
      <section class="cluster">
        <div class="gauge-card">
          <svg id="gauge-RPM" viewBox="0 0 260 250" width="260" height="250" aria-label="Toerental"></svg>
        </div>

        <div class="odo-panel">
          <p class="eyebrow">Ritafstand</p>

          <div class="odometer">
            <div class="odo-tape">
              <span class="odo-digit" id="odo-0">0</span>
              <span class="odo-digit" id="odo-1">0</span>
              <span class="odo-digit" id="odo-2">0</span>
              <span class="odo-digit" id="odo-3">0</span>
              <span class="odo-sep">.</span>
              <span class="odo-digit odo-frac" id="odo-4">0</span>
            </div>
            <span class="odo-unit">km</span>
          </div>

          <!-- Live consumption: the headline number for anyone actually driving -->
          <div class="consumption" id="consumption" hidden>
            <span class="consumption-value" id="consumption-value">&#8212;</span>
            <span class="consumption-unit">L/100km</span>
          </div>

          <button id="reset-session-btn" class="btn btn-ghost btn-sm">Reset rit</button>
        </div>

        <div class="gauge-card">
          <svg id="gauge-SPEED" viewBox="0 0 260 250" width="260" height="250" aria-label="Snelheid"></svg>
        </div>
      </section>

      <!-- ── Live chart ─────────────────────────────────────── -->
      <section class="panel chart-panel">
        <div class="panel-header">
          <div class="panel-title-group">
            <h2 class="panel-title">Verloop</h2>
            <span class="chart-legend">
              <span class="legend-item"><i class="legend-swatch" style="--c:#ff4444"></i>Toerental</span>
              <span class="legend-item"><i class="legend-swatch" style="--c:#0099ff"></i>Snelheid</span>
            </span>
          </div>
          <span class="chart-window" id="chart-window">laatste 90 s</span>
        </div>
        <div class="chart-wrap">
          <canvas id="chart" width="1200" height="260" aria-label="Verloop van toerental en snelheid"></canvas>
          <span class="chart-empty" id="chart-empty">Nog geen data &#8212; verbind met de auto</span>
        </div>
      </section>

      <!-- ── Metric cards ───────────────────────────────────── -->
      <section class="metrics-row">
        <% metrics.forEach((m) => { %>
        <div class="metric-card" style="--mc:<%= m.color %>">
          <div class="mc-row">
            <span class="mc-label"><%- m.label %></span>
            <span class="mc-val"><b id="val-<%= m.key %>">&#8212;</b> <small><%- m.unit %></small></span>
          </div>
          <div class="mc-track"><div id="bar-<%= m.key %>" class="mc-fill"></div></div>
        </div>
        <% }); %>
      </section>

      <!-- ── Session statistics ─────────────────────────────── -->
      <section class="panel stats-panel">
        <div class="panel-header">
          <div class="panel-title-group">
            <h2 class="panel-title">Sessie</h2>
          </div>
          <button id="export-btn" class="btn btn-ghost btn-sm" disabled>Exporteer CSV</button>
        </div>
        <div class="stats-grid">
          <% stats.forEach((s) => { %>
          <div class="stat">
            <span class="stat-label"><%- s.label %></span>
            <span class="stat-value" id="stat-<%= s.key %>">&#8212;<% if (s.unit) { %> <small><%- s.unit %></small><% } %></span>
          </div>
          <% }); %>
        </div>
      </section>

    </main>
  </div>

  <!-- Toast notifications -->
  <div class="toasts" id="toasts" aria-live="polite"></div>

  <script src="/js/chart.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
